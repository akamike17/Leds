@model EditorViewModel
@{
    ViewData["Title"] = "Editor";
    var projectId = Model.ProjectId.ToString("N");
}

<div class="editor-layout">
    <!-- Toolbar superior -->
    <div class="editor-toolbar d-flex align-items-center gap-2 p-2 bg-dark text-light" id="toolbar">
        <button class="btn btn-sm btn-outline-light" id="btn-new" title="Nuevo proyecto">＋ Nuevo</button>
        <button class="btn btn-sm btn-outline-light" id="btn-save" title="Guardar">💾 Guardar</button>
        <button class="btn btn-sm btn-outline-light" id="btn-open" title="Abrir">📂 Abrir</button>
        <button class="btn btn-sm btn-primary" id="btn-preview" title="Abrir simulador">▶ Simulador</button>
        <span class="ms-2 small text-muted" id="project-name">Sin título</span>
        <button class="btn btn-sm btn-outline-light ms-3 d-none" id="btn-save-library" title="Guardar selección en Mi biblioteca">📚 Guardar en biblioteca</button>
        <button class="btn btn-sm btn-outline-light ms-1" id="btn-library" title="Abrir biblioteca">📚 Biblioteca</button>
        <button class="btn btn-sm btn-outline-light ms-1" id="btn-image" title="Importar imagen">🖼 Imagen</button>
        <input type="file" id="image-file" accept="image/png,image/jpeg,image/webp,image/gif" style="display:none">

        <!-- Target (dispositivo de envío) + envío -->
        <span class="ms-auto d-flex align-items-center gap-2">
            <label class="small text-muted mb-0" for="device-select">Dispositivo:</label>
            <select class="form-select form-select-sm w-auto" id="device-select" aria-label="Dispositivo de envío"></select>
            <button class="btn btn-sm btn-outline-light" id="btn-send" title="Enviar al target">📤 Enviar</button>
        </span>
    </div>

    <div class="editor-body d-flex">
        <!-- Herramientas izquierda -->
        <div class="editor-tools p-2 bg-secondary text-light" id="tools-panel" role="toolbar" aria-label="Herramientas" style="width:48px">
            <button class="tool-btn" data-tool="select" title="Selección" aria-label="Herramienta selección">🖱</button>
            <button class="tool-btn" data-tool="text" title="Texto" aria-label="Herramienta texto">T</button>
            <button class="tool-btn" data-tool="icon" title="Icono" aria-label="Herramienta icono">✦</button>
            <button class="tool-btn" data-tool="pencil" title="Lápiz" aria-label="Herramienta lápiz">✏️</button>
            <button class="tool-btn" data-tool="eraser" title="Borrador" aria-label="Herramienta borrador">⌫</button>
            <button class="tool-btn" data-tool="line" title="Línea" aria-label="Herramienta línea">╱</button>
            <button class="tool-btn" data-tool="rect" title="Rectángulo" aria-label="Herramienta rectángulo">▭</button>
            <button class="tool-btn" data-tool="ellipse" title="Elipse" aria-label="Herramienta elipse">◯</button>
            <button class="tool-btn" data-tool="fill" title="Relleno" aria-label="Herramienta relleno">🪣</button>
        </div>

        <!-- Canvas centro -->
        <div class="editor-canvas flex-grow-1 bg-black d-flex align-items-center justify-content-center" id="canvas-host">
            <div style="position:relative;line-height:0">
                <canvas id="led-canvas" class="led-canvas" role="img" aria-label="Lienzo LED"></canvas>
                <canvas id="selection-overlay" class="led-canvas" style="position:absolute;left:0;top:0;pointer-events:none" role="presentation"></canvas>
            </div>
        </div>

        <!-- Inspector derecha -->
        <div class="editor-inspector p-2 bg-dark text-light" id="inspector" style="width:240px">
            <h6 class="text-muted">Inspector</h6>
            <p class="small text-muted" id="inspector-empty">Selecciona un objeto para editarlo.</p>
            <div id="inspector-content" class="d-none"></div>
        </div>
    </div>

    <!-- Timeline abajo -->
    <div class="editor-timeline p-2 bg-dark text-light d-flex align-items-center" id="timeline">
        <span class="me-2 small">Escena:</span>
        <select class="form-select form-select-sm w-auto" id="scene-select"></select>
        <button class="btn btn-sm btn-outline-light ms-1" id="btn-add-scene" title="Añadir escena">＋</button>
        <span class="ms-3 small">Capa:</span>
        <select class="form-select form-select-sm w-auto" id="layer-select"></select>
        <button class="btn btn-sm btn-outline-light ms-1" id="btn-add-layer" title="Añadir capa">＋</button>
        <label class="ms-3 small text-muted mb-0" for="scene-duration">Duración (s):</label>
        <input type="number" class="form-control form-control-sm w-auto ms-1" id="scene-duration" min="1" step="0.5" style="width:80px" />
        <span class="ms-3 small text-muted" id="scene-time">0.0s / 5.0s</span>
        <span class="ms-3 d-flex align-items-center gap-1" title="Agrupar/alinear selección">
            <button class="btn btn-sm btn-outline-light" id="btn-group" title="Agrupar (Ctrl+G)">🧩</button>
            <button class="btn btn-sm btn-outline-light" id="btn-ungroup" title="Desagrupar (Ctrl+Shift+G)">🧩−</button>
            <button class="btn btn-sm btn-outline-light" id="btn-align-left" title="Alinear izquierda">⇤</button>
            <button class="btn btn-sm btn-outline-light" id="btn-align-hcenter" title="Alinear centro horizontal">⇹</button>
            <button class="btn btn-sm btn-outline-light" id="btn-align-right" title="Alinear derecha">⇥</button>
            <button class="btn btn-sm btn-outline-light" id="btn-align-top" title="Alinear arriba">⇧</button>
            <button class="btn btn-sm btn-outline-light" id="btn-align-vmiddle" title="Alinear centro vertical">↕</button>
            <button class="btn btn-sm btn-outline-light" id="btn-align-bottom" title="Alinear abajo">⇩</button>
        </span>
        <button class="btn btn-sm btn-outline-light ms-auto" id="btn-play" aria-label="Reproducir preview" title="Reproducir/Pausar (Espacio)">▶</button>
        <button class="btn btn-sm btn-outline-light" id="btn-pause" aria-label="Pausar" title="Pausar">⏸</button>
        <button class="btn btn-sm btn-outline-light" id="btn-stop" aria-label="Reiniciar" title="Reiniciar al inicio">⏮</button>
    </div>
</div>

<div class="modal fade" id="simulator-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content simulator-modal-content">
      <div class="modal-header">
        <h5 class="modal-title">SIMULADOR <span class="text-muted small">Editor = simulador</span></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body simulator-stage">
        <canvas id="simulator-canvas" aria-label="Simulador del letrero LED"></canvas>
      </div>
      <div class="modal-footer justify-content-between">
        <span class="small text-muted" id="simulator-parity-status">Vista local · no implica ESP32 conectado</span>
        <div>
          <button type="button" class="btn btn-outline-light btn-sm" id="simulator-stop">■ Detener</button>
          <button type="button" class="btn btn-primary btn-sm" id="simulator-play">▶ Reproducir</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Barra de estado consolidada (spec 19): cambios, escena/tiempo, selección, target, red, envío -->
<div class="status-hud bg-dark text-light d-flex align-items-center gap-2 px-2 py-1 border-top border-secondary"
     id="status-hud" role="status" aria-live="polite">
    <span class="small" id="stat-dirty">Sin cambios</span>
    <span class="small text-muted" id="stat-selection">0 seleccionados</span>
    <span class="small text-muted" id="stat-target">Target: —</span>
    <span class="small d-flex align-items-center gap-1" id="stat-net">
        <span class="net-dot bg-secondary" id="net-dot" title="Estado de red"></span>
        <span class="small text-muted" id="net-label">Sin dispositivo</span>
    </span>
    <span class="small text-muted" id="stat-send">Sin envío</span>
    <span class="small ms-auto" id="stat-notify" role="status"></span>
</div>

<input type="hidden" id="project-id" value="@projectId" />

<!-- Modal de biblioteca (dibujos propios + iconos incluidos) -->
<div class="modal fade" id="library-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header">
        <h5 class="modal-title">Biblioteca</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <ul class="nav nav-tabs mb-3" id="library-tabs" role="tablist">
          <li class="nav-item"><button class="nav-link active" data-lib-tab="drawings" type="button">Mis dibujos</button></li>
          <li class="nav-item"><button class="nav-link" data-lib-tab="icons" type="button">Iconos</button></li>
          <li class="nav-item"><button class="nav-link" data-lib-tab="images" type="button">Imágenes</button></li>
        </ul>
        <div class="row g-2" id="library-grid"></div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Nuevo proyecto (spec 12): matriz predefinida o personalizada -->
<div class="modal fade" id="new-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-sm">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header">
        <h5 class="modal-title">Nuevo letrero</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <label class="form-label small mb-1">Nombre</label>
        <input class="form-control form-control-sm mb-3" id="new-name" value="Sin título" />
        <label class="form-label small mb-1">Matriz</label>
        <select class="form-select form-select-sm mb-2" id="new-matrix">
          <option value="16,16">16x16</option>
          <option value="32,16" selected>32x16</option>
          <option value="32,32">32x32</option>
          <option value="64,32">64x32</option>
          <option value="custom">Personalizada</option>
        </select>
        <div class="d-flex gap-2 d-none" id="new-custom">
          <input class="form-control form-control-sm" id="new-width" type="number" min="1" max="256" value="32" placeholder="ancho" />
          <input class="form-control form-control-sm" id="new-height" type="number" min="1" max="256" value="16" placeholder="alto" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn-new-create">Crear</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal de icon picker integrado (spec 19): buscar + grid + insertar sin ir a /Library -->
<div class="modal fade" id="icon-picker-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header">
        <h5 class="modal-title">Iconos</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <input type="search" class="form-control form-control-sm mb-3" id="icon-picker-search"
               placeholder="Buscar icono…  (corazón, herramienta, teléfono)" autocomplete="off" />
        <div class="row g-2" id="icon-picker-grid"></div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de cambios sin guardar (Guardar/Descartar/Cancelar) para navegación interna -->
<div class="modal fade" id="unsaved-modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-sm">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header">
        <h5 class="modal-title">Cambios sin guardar</h5>
      </div>
      <div class="modal-body small">Tienes cambios sin guardar. ¿Qué quieres hacer?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="unsaved-cancel">Cancelar</button>
        <button type="button" class="btn btn-outline-light btn-sm" id="unsaved-discard">Descartar</button>
        <button type="button" class="btn btn-primary btn-sm" id="unsaved-save">Guardar</button>
      </div>
    </div>
  </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/editor.css" asp-append-version="true" />
}
@section Scripts {
    <script type="module" src="~/js/editor/editor.js" asp-append-version="true"></script>
}
