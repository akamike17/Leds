@model ProjectSummaryViewModel
@{
    ViewData["Title"] = "Proyectos";
}

<div class="p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Proyectos</h1>
        <a class="btn btn-primary btn-sm" asp-controller="Projects" asp-action="New">+ Nuevo proyecto</a>
    </div>

    @if (Model.Projects.Count == 0)
    {
        <div class="alert alert-secondary">
            No hay proyectos guardados. <a asp-controller="Projects" asp-action="New">Crea el primero</a>.
        </div>
    }
    else
    {
        <table class="table table-striped table-sm">
            <thead>
                <tr><th>Nombre</th><th>Lienzo</th><th>Modificado</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Projects)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.Canvas</td>
                        <td>@p.UpdatedAt.ToLocalTime().ToString("g")</td>
                        <td><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", "Editor", new { id = p.Id })">Abrir</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>