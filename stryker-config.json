{
  "stryker-config": {
    "reporters": [ "progress", "html", "json" ],
    "project-info": {
      "name": "github.com/DSLetras",
      "module": "DSLetreros",
      "version": "1.0.0"
    },
    "test-projects": [ "DSLetreros.Tests/DSLetreros.Tests.csproj" ],
    "thresholds": {
      "high": 70,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "**/Domain/Deployment/*.cs",
      "**/Domain/Validation/*.cs",
      "**/Application/Services/*.cs",
      "**/Infrastructure/Persistence/*.cs",
      "**/Infrastructure/Transport/*.cs",
      "**/Infrastructure/Logging/*.cs",
      "!**/Domain/Deployment/IDisplayTarget.cs",
      "!**/Infrastructure/Persistence/AtlasJson.cs",
      "!**/Application/Services/BuiltInIcons.cs"
    ],
    "ignore-mutations": [
      "update"
    ],
    "ignore-methods": [
      "Dispose",
      "Equals",
      "GetHashCode",
      "ToString"
    ]
  }
}